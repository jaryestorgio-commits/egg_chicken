SECRET_KEY=replace with your own secret key
JWT_SECRET_KEY=replace with your own jwt secret key
DATABASE_URL=postgresql+psycopg://username:userpassword@Localhhost:5432/database_name
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Xendit test mode only. Never put these values in frontend files.
XENDIT_SECRET_KEY=replace_with_your_test_secret_key
XENDIT_CALLBACK_TOKEN=replace_with_the_webhook_callback_token
XENDIT_SUCCESS_URL=http://127.0.0.1:5500/pages/order-details.html?id={order_id}&payment=success
XENDIT_FAILURE_URL=http://127.0.0.1:5500/pages/order-details.html?id={order_id}&payment=failed
